<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LSLibDir Condition="'$(LSLibDir)' == ''">../../../lslib</LSLibDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LSLib"><HintPath>$(LSLibDir)/LSLib.dll</HintPath></Reference>
    <Reference Include="LZ4"><HintPath>$(LSLibDir)/LZ4.dll</HintPath></Reference>
    <Reference Include="LZ4pn"><HintPath>$(LSLibDir)/LZ4pn.dll</HintPath></Reference>
    <Reference Include="ZstdSharp"><HintPath>$(LSLibDir)/ZstdSharp.dll</HintPath></Reference>
    <Reference Include="System.IO.Hashing"><HintPath>$(LSLibDir)/System.IO.Hashing.dll</HintPath></Reference>
    <Reference Include="OpenTK.Mathematics"><HintPath>$(LSLibDir)/OpenTK.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
